# Copier ce fichier en .env et renseigner les vraies valeurs (fichier .env ignoré par git)

# PostgreSQL
DATABASE_URL=postgresql://postgres:<mot_de_passe>@localhost:5432/pfa13_db

# Ollama (LLM local)
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3.2:3b

# Chemins des seeds (relatifs au répertoire de travail depuis lequel uvicorn est lancé)
REGLES_JSON_PATH=database/seeds/regles_expertes.json
MESURES_JSON_PATH=database/seeds/mesures.json